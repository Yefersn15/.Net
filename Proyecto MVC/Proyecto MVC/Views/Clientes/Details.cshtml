@model Proyecto_MVC.Models.Clientes

@{
    ViewData["Title"] = "Detalles del Cliente";
}

<h1>Detalles del Cliente</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

        <dt class="col-sm-2">Tipo Documento</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.tipoDocumento)</dd>

        <dt class="col-sm-2">Número Documento</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.NumeroDocumento)</dd>

        <dt class="col-sm-2">Nombres</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Nombres)</dd>

        <dt class="col-sm-2">Apellidos</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Apellidos)</dd>

        <dt class="col-sm-2">Email</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Email)</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Telefono)</dd>

        <dt class="col-sm-2">Dirección</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Direccion)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>
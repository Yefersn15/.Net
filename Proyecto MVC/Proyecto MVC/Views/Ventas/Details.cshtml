@model Proyecto_MVC.Models.Ventas
@{
    ViewData["Title"] = "Detalles de la Venta";
}

<h1>Detalles de la Venta</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">ID</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Id)</dd>

        <dt class="col-sm-2">Cliente</dt>
        <dd class="col-sm-10">
            @if (ViewBag.Cliente != null)
            {
                var cliente = ViewBag.Cliente as Proyecto_MVC.Models.Clientes;
                @:$@cliente.Nombres @cliente.Apellidos
            }
            else
            {
                @:Cliente no encontrado
            }
        </dd>

        <dt class="col-sm-2">Producto</dt>
        <dd class="col-sm-10">
            @if (ViewBag.Producto != null)
            {
                var producto = ViewBag.Producto as Proyecto_MVC.Models.Productos;
                @: @producto.Nombre
            }
            else
            {
                @:Producto no encontrado
            }
        </dd>

        <dt class="col-sm-2">Precio unitario</dt>
        <dd class="col-sm-10">@Model.Precio.ToString("0.00")</dd>

        <dt class="col-sm-2">Cantidad</dt>
        <dd class="col-sm-10">@Model.Cantidad</dd>

        <dt class="col-sm-2">Fecha de Venta</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FechaVenta)</dd>

        <dt class="col-sm-2">Total</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Total)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>